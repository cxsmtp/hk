# Copy this file to .env.local-native at the repository root when you need to
# override the default native-demo values.
#
# The native demo keeps the browser URL stable:
#   https://hawk.localhost:3443
#
# It expects host-managed PostgreSQL and Redis, not Docker Desktop.

NATIVE_POSTGRES_HOST=127.0.0.1
NATIVE_POSTGRES_PORT=5432
NATIVE_POSTGRES_DB=aicontrol
NATIVE_POSTGRES_USER=postgres
NATIVE_POSTGRES_PASSWORD=postgres

NATIVE_REDIS_HOST=127.0.0.1
NATIVE_REDIS_PORT=6379
NATIVE_REDIS_DB=0

API_BASE_URL=https://hawk.localhost:3443/api
WEB_ORIGIN=https://hawk.localhost:3443
FRONTEND_URL=https://hawk.localhost:3443
NEXT_PUBLIC_API_URL=https://hawk.localhost:3443/api
CORS_ORIGINS=https://hawk.localhost:3443,https://api.hawk.localhost:3443,http://127.0.0.1:3000,http://localhost:3000

# Keep these aligned with your existing local/demo tenant if you already have
# values in .env. These defaults are only for a local demo stack.
SECRET_KEY=local-native-demo-secret-key-change-before-any-real-pilot
SECRET_KEY_LOCK_ENABLED=false
SECRET_KEY_LOCK_PEPPER=local-native-demo-lock-pepper
CONNECTOR_SECRETS_KEY=local-native-demo-connector-key
CONNECTOR_SECRETS_KDF_SALT=local-native-demo-connector-salt
ONPREM_BUNDLE_SIGNING_SECRET=local-native-demo-onprem-signing-secret

