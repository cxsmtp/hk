# The web console. Stages:
#   build, deps, integrity, runtime  the production image deploy/compose.yaml runs (target: runtime);
#   dev                              the last stage, the default for the development compose files (npm run dev).
# The base image is pinned by digest: node 22 (LTS; node 20 is past its end of life). The runtime takes Alpine's security
# fixes released since that image was made (apk upgrade), so the container scan (.github/workflows/security.yml) stays clean.
#
# The console is built once, on the machine that builds (BUILDPLATFORM), and the same files go into the amd64 and the
# arm64 image: their file lists are then the same, byte for byte, as the release workflow requires (/settings/guide/updates).
# Only the production node_modules are installed for each platform (deps).

FROM --platform=$BUILDPLATFORM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build

WORKDIR /workspace/apps/web

COPY apps/web/package.json apps/web/package-lock.json ./
# Building behind a company proxy that inspects TLS? Pass its CA certificate (as CxMissionZero's Dockerfile does):
#   docker build --secret id=ca,src=company-ca.pem ...   (deploy/install.sh: HAWK_BUILD_CA_FILE=company-ca.pem)
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi && \
    npm ci

COPY apps/web ./
COPY packages /workspace/packages
# The version shown bottom-left on every screen (next.config.mjs reads it).
COPY VERSION /workspace/VERSION

# "/api": the API on the console's own address, behind deploy/compose.yaml's front proxy, so one image serves any
# name or address people use to reach it.
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_CONTROL_COVERAGE_UI_ENABLED=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CONTROL_COVERAGE_UI_ENABLED=${NEXT_PUBLIC_CONTROL_COVERAGE_UI_ENABLED}
ENV NEXT_TELEMETRY_DISABLED=1
# Never the demo build: no invented demo data in the production console (apps/web/demo-build.mjs). next build fails if
# demo flags are set, and the output is checked for the demo data module's marker.
ENV DEMO_BUILD=0

RUN npm run build \
    && if grep -rqs "hawk-demo-fallback-data" .next; then echo "Demo data found in the production build" >&2; exit 1; fi \
    && rm -rf node_modules && npm cache clean --force

# The production dependencies, for the platform the image is for.
FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS deps
WORKDIR /workspace/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi && \
    npm ci --omit=dev && npm cache clean --force

# ---- The file list: every file of the console the image ships, with its SHA-256 (/settings/guide/updates) -----------------
# Not node_modules: its native packages differ between amd64 and arm64. Signed by the release workflow.
FROM --platform=$BUILDPLATFORM python:3.11-slim@sha256:61e01f72680f86a5279ad510818ab7b2ee9f049822589d4e34e33e044360356c AS integrity
ARG HAWK_COMMIT=""
ARG HAWK_REPOSITORY=""
COPY infra/scripts/integrity.py /tool/infra/scripts/integrity.py
COPY apps/api/app/services/integrity/manifest.py /tool/apps/api/app/services/integrity/manifest.py
COPY --from=build /workspace/apps/web /workspace/apps/web
COPY --from=build /workspace/packages /workspace/packages
COPY --from=build /workspace/VERSION /workspace/VERSION
RUN python /tool/infra/scripts/integrity.py write /workspace --image web --commit "$HAWK_COMMIT" --repository "$HAWK_REPOSITORY" \
      --tree apps/web --tree packages --file VERSION --skip-dir apps/web/node_modules --skip-dir apps/web/.next/cache

FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS runtime

# Alpine's security fixes, then no package manager at run time (as CxMissionZero's image): Next.js is started with node.
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then cat /etc/ssl/certs/ca-certificates.crt /run/secrets/ca > /tmp/ca.pem && export SSL_CERT_FILE=/tmp/ca.pem; fi \
    && apk upgrade --no-cache && rm -f /tmp/ca.pem \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

WORKDIR /workspace/apps/web
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=build --chown=1000:1000 /workspace/apps/web ./
COPY --from=deps --chown=1000:1000 /workspace/apps/web/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /workspace/packages /workspace/packages
COPY --from=build /workspace/VERSION /workspace/VERSION
COPY --from=integrity /workspace/integrity.json /workspace/integrity.json

# The node user, uid 1000.
USER 1000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/login',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]

FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS dev

WORKDIR /workspace/apps/web

COPY apps/web/package.json /workspace/apps/web/package.json
COPY apps/web/package-lock.json /workspace/apps/web/package-lock.json
RUN npm ci

COPY apps/web /workspace/apps/web
COPY packages /workspace/packages
COPY VERSION /workspace/VERSION

EXPOSE 3000
RUN chown -R 1000:1000 /workspace/apps/web /workspace/packages
USER 1000
