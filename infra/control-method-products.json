{
  "schema": "hawk.control-method-products/1.0",
  "release_ready": false,
  "methods": [
    {
      "id": "browser_extension",
      "root": "extension",
      "version_source": "extension/package.json",
      "sources": [
        "extension/package.json",
        "extension/tests/e2e/browser-extension.spec.ts"
      ],
      "lifecycle_gates": {
        "clean_install": {
          "state": "target_required",
          "basis_reason": "A build and synthetic host test do not prove a clean installation in managed Chrome or Edge."
        },
        "restart": {
          "state": "target_required",
          "basis_reason": "Managed Chrome and Edge restart acceptance is absent."
        },
        "reconnect": {
          "state": "target_required",
          "basis_reason": "Managed browser reconnect acceptance is absent."
        },
        "allow": {
          "state": "repository_verified",
          "basis_reason": "Synthetic allow path is covered by the selected E2E source."
        },
        "deny": {
          "state": "repository_verified",
          "basis_reason": "Synthetic deny path is covered by the selected E2E source."
        },
        "approval": {
          "state": "target_required",
          "basis_reason": "Managed approval workflow acceptance is absent."
        },
        "revocation": {
          "state": "target_required",
          "basis_reason": "Managed revocation acceptance is absent."
        },
        "outage": {
          "state": "target_required",
          "basis_reason": "Managed browser outage acceptance is absent."
        },
        "upgrade": {
          "state": "target_required",
          "basis_reason": "Managed browser upgrade acceptance is absent."
        },
        "rollback": {
          "state": "target_required",
          "basis_reason": "Managed browser rollback acceptance is absent."
        },
        "evidence": {
          "state": "repository_verified",
          "basis_reason": "Repository source and test digests are emitted."
        }
      },
      "checks": [
        {
          "name": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "cwd": "extension",
          "timeout_seconds": 120
        },
        {
          "name": "synthetic_e2e",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "tests/e2e/browser-extension.spec.ts"
          ],
          "cwd": "extension",
          "timeout_seconds": 120
        }
      ],
      "evidence": {
        "state": "target_required",
        "unverified_reason": "Pinned Chromium build and two complete synthetic E2E runs passed (20 of 20 checks) on distinct OS-assigned loopback fixture ports. Managed Chrome/Edge installation, restart, reconnect, upgrade, rollback, and customer-host acceptance remain unverified."
      },
      "release_ready": false,
      "target_check": {
        "id": "managed_browser_acceptance",
        "runner": "extension/tests/e2e/browser-extension.spec.ts",
        "proof_scope": "synthetic_browser_only",
        "intended_target": "managed_chrome_and_edge",
        "state": "target_required",
        "blockers": [
          "current_and_previous_signed_managed_packages_absent",
          "managed_install_upgrade_rollback_acceptance_absent"
        ]
      }
    },
    {
      "id": "mcp_gateway",
