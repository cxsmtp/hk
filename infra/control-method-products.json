        "apps/api/tests/test_mcp_proxy_authorize_contract.py",
        "infra/scripts/run_isolated_mcp_client_acceptance.py"
      ],
      "lifecycle_gates": {
        "clean_install": {
          "state": "target_required",
          "basis_reason": "Package tests and a dry-run tarball do not prove clean installation on a remote MCP host."
        },
        "restart": {
          "state": "target_required",
          "basis_reason": "Remote MCP restart acceptance is absent."
        },
        "reconnect": {
          "state": "target_required",
          "basis_reason": "Remote MCP reconnect acceptance is absent."
        },
        "allow": {
          "state": "repository_verified",
          "basis_reason": "Local governed allow tests are covered."
        },
        "deny": {
          "state": "repository_verified",
          "basis_reason": "Local governed deny tests are covered."
        },
        "approval": {
          "state": "target_required",
          "basis_reason": "Interactive remote approval acceptance is absent."
        },
        "revocation": {
          "state": "target_required",
          "basis_reason": "Remote revocation acceptance is absent."
        },
        "outage": {
          "state": "repository_verified",
          "basis_reason": "Local fail-secure outage paths are tested."
        },
        "upgrade": {
          "state": "target_required",
          "basis_reason": "Remote upgrade acceptance is absent."
        },
        "rollback": {
          "state": "target_required",
          "basis_reason": "Remote rollback acceptance is absent."
        },
