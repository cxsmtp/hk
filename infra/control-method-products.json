          "state": "repository_verified",
          "basis_reason": "Repository source and test digests are emitted."
        }
      },
      "checks": [
        {
          "name": "unit",
          "argv": [
            "npm",
            "test"
          ],
          "cwd": "packages/hawk-mcp-proxy",
          "timeout_seconds": 120
        },
        {
          "name": "package_dry_run",
          "argv": [
            "npm",
            "pack",
            "--dry-run",
            "--json"
          ],
          "cwd": "packages/hawk-mcp-proxy",
          "env": {
            "NPM_CONFIG_CACHE": "/private/tmp/hawk-four-control-method-npm-cache"
          },
          "timeout_seconds": 60
        }
      ],
      "evidence": {
        "state": "target_required",
        "unverified_reason": "A fresh isolated PostgreSQL, Redis, worker, beat, and API lab passed all eight strict control-plane checks. The official MCP TypeScript SDK 1.29.0 and actual Codex CLI 0.154.0 each completed three fresh synthetic read-only connections: allow, restart and reconnect allow, then exact agent_session_revoked denial. Each run had distinct correlated Hawk evidence and child call counts 1, 2, 2. The original write-action policy remains enforced. Claude Code connected and advertised the read tool without invoking it; its installed native hook signed a synthetic before-agent request, then the unchanged callback returned HTTP 500 and the hook failed closed with policy_service_unavailable. A rollback-only diagnostic did not reach the callback handler: native PostgreSQL on port 55432 rejected the connection with could not open file / No such file or directory; the file is unidentified. Claude lifecycle evidence is absent. Claude Code compatibility, customer-host acceptance, interactive approval, clean install, upgrade, and rollback remain unverified."
      },
      "release_ready": false,
      "target_check": {
        "id": "real_claude_code_mcp_acceptance",
        "runner": "infra/scripts/run_isolated_mcp_client_acceptance.py",
        "proof_scope": "isolated_local_client_only",
        "intended_target": "supported_remote_mcp_host",
        "state": "target_required",
        "blockers": [
          "current_and_previous_release_artifacts_absent",
          "supported_target_host_acceptance_absent"
        ]
      }
    },
