FROM python:3.11-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7 AS builder

COPY apps/api/requirements.lock /tmp/requirements.lock
# Building behind a company proxy that inspects TLS? Pass its CA certificate (as CxMissionZero's Dockerfile does):
#   docker build --secret id=ca,src=company-ca.pem ...   (deploy/install.sh: HAWK_BUILD_CA_FILE=company-ca.pem)
# Without it, nothing changes.
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then cat /etc/ssl/certs/ca-certificates.crt /run/secrets/ca > /tmp/ca.pem && export PIP_CERT=/tmp/ca.pem; fi && \
    pip wheel --require-hashes --no-cache-dir --wheel-dir /wheels -r /tmp/requirements.lock && rm -f /tmp/ca.pem

FROM python:3.11-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7 AS api-base

WORKDIR /workspace/apps/api

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# pg_dump and pg_restore, for backups and restores (app/services/pg_tools.py; deploy/README.md: Backups). PostgreSQL 17's
# client (Debian 13's), which dumps and restores the PostgreSQL 16 of deploy/compose.yaml; pinned to the version tested,
# as the base image is pinned by its digest and the Python packages by their hashes.
# TODO(owner): pin through snapshot.debian.org, so the build still finds this exact version after a security update.
RUN apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-17=17.12-0+deb13u1 \
  && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /tmp/requirements.txt
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /tmp/requirements.txt \
  && rm -rf /wheels /tmp/requirements.txt

COPY apps/api /workspace/apps/api
COPY packages /workspace/packages
COPY docs/evidence /workspace/docs/evidence
COPY infra/scripts /workspace/infra/scripts
# The version shown in the console and on /health, the terms of use people accept (deploy/README.md), the licence and
# the version log.
COPY VERSION TERMS.md LICENSE CHANGELOG.md /workspace/

# /data: the API's own data folder (0700), e.g. the first administrator's one-time password file until it is changed,
# and the HTTPS choices and certificates (Settings → HTTPS). /hawk-proxy: the front proxy's configuration, written here.
RUN useradd --uid 1000 --create-home --shell /bin/bash appuser \
  && mkdir -p /artifacts /run/hawk /data /hawk-proxy /certs \
  && chown -R 1000:1000 /workspace /artifacts /run/hawk /data /hawk-proxy /certs \
  && chmod 0700 /data /hawk-proxy

EXPOSE 8000
USER 1000

FROM api-base AS test
COPY tools/dev /workspace/tools/dev
COPY scripts /workspace/scripts
USER root
RUN mkdir -p /test-results && chown 1000:1000 /test-results
USER 1000

# ---- The file list: every file the image ships, with its SHA-256 (docs/integrity.md) ----------------------------------
# The release workflow signs this exact file (a GitHub build attestation, logged by Sigstore), and the API checks its own
# files and that signature (Settings → Updates → Software integrity), as CxMissionZero's Dockerfile integrity stage.
FROM api-base AS integrity
ARG HAWK_COMMIT=""
ARG HAWK_REPOSITORY=""
USER root
RUN python /workspace/infra/scripts/integrity.py write /workspace --image api --commit "$HAWK_COMMIT" --repository "$HAWK_REPOSITORY" \
      --tree apps/api --tree packages --tree docs/evidence --tree infra/scripts \
      --file VERSION --file TERMS.md --file LICENSE --file CHANGELOG.md

FROM api-base AS runtime
COPY --from=integrity /workspace/integrity.json /workspace/integrity.json
USER root
# No test runner and no package manager at run time (CxMissionZero's runtime image carries no npm either).
RUN pip uninstall -y pytest iniconfig pluggy \
  && python -m pip uninstall -y pip
ENV HAWK_DATA_DIR=/data
USER 1000
# deploy/compose.yaml runs the API from this image; worker and beat override the check with their heartbeat.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-m", "app.cli.healthcheck"]
