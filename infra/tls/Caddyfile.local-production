{
	admin off
	auto_https off
}

:8443 {
	tls /certs/hawk-local.crt /certs/hawk-local.key

	@api host api.hawk.localhost
	handle @api {
		reverse_proxy host.docker.internal:8000 {
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	@web host hawk.localhost
	handle @web {
		reverse_proxy host.docker.internal:3001 {
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond "Unknown Hawk production host" 421
	}
}
