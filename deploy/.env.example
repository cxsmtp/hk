# Hawk AI on one machine (deploy/README.md). deploy/install.sh copies this file to deploy/.env the first time and
# fills in HAWK_DATA_DIR; it never overwrites deploy/.env afterwards. Secrets are not set here: install.sh generates
# them into ${HAWK_DATA_DIR}/secrets (folder 0700, files 0600).

# Where the secrets live. Keep it outside this folder, and back it up with the database.
HAWK_DATA_DIR=/var/lib/hawk-ai

# Reachable from this machine only by default. To serve other machines, set BIND_ADDRESS=0.0.0.0 (or one
# interface's address) and HAWK_HOST to the name or address people type in their browser.
BIND_ADDRESS=127.0.0.1
PORT=3000
HAWK_HOST=localhost
# The full address, when it differs from https://HAWK_HOST:PORT (for example behind another proxy on port 443).
PUBLIC_URL=

# Time zone for scheduled work, e.g. Asia/Dubai.
TZ=UTC

# --- First run (all optional) ---------------------------------------------------------------------------------
# The first administrator's email (default admin@hawk.local). With ADMIN_PASSWORD too, that is their first
# password instead of a generated one; they choose their own at first sign-in either way.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# setup-code: print a setup code in the log instead, and create the first administrator on the sign-in page.
FIRST_ADMIN=
# <email>: the person deploying accepts the terms of use (TERMS.md) for the organisation and everyone, on record.
ACCEPT_TERMS=
# The organisation's name (else the administrator gives it when accepting the terms).
ORGANISATION_NAME=

# --- Sizing ----------------------------------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=4

# --- Identity of this deployment (lower-case letters, digits and dashes) -------------------------------------------
DEPLOYMENT_ID=hawk
DEPLOYMENT_REGION=on-premise
DEPLOYMENT_DATA_LOCATION=on-premise
