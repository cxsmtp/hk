# Hawk AI on one machine (/settings/guide/install). deploy/install.sh copies this file to deploy/.env the first time and
# fills in HAWK_DATA_DIR; it never overwrites deploy/.env afterwards. Secrets are not set here: install.sh generates
# them into ${HAWK_DATA_DIR}/secrets (folder 0700, files 0600).

# Where the secrets live. Keep it outside this folder, and back it up with the database.
HAWK_DATA_DIR=/var/lib/hawk-ai

# Reachable from this machine only by default. To serve other machines, set BIND_ADDRESS=0.0.0.0 (or one
# interface's address) and HAWK_HOST to the name or address people type in their browser.
BIND_ADDRESS=127.0.0.1
PORT=3000
HAWK_HOST=localhost
# The full address, when it differs from https://HAWK_HOST:PORT (for example behind another proxy on port 443).
PUBLIC_URL=
# Plain http: redirected to https while HTTPS only (and where Let's Encrypt checks the name: it needs 80). Set another
# port if 80 is taken on this machine.
HTTP_REDIRECT_PORT=80

# --- HTTPS (/settings/guide/https; easiest from Settings → HTTPS, whose choice then wins) -----------------------
# on: HTTPS only (your certificate, else self-signed); off: plain http; both: side by side.
HTTPS=on
# A. Your company's certificate, in ${HAWK_DATA_DIR}/certs: /certs/server.crt (with its chain) and /certs/server.key,
#    or one /certs/server.pfx and its password. Renewed files are picked up within 5 minutes, with no restart.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_KEY_PASSPHRASE=
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=
# B. A free certificate from Let's Encrypt for a public name (means you accept its Subscriber Agreement); needs
#    BIND_ADDRESS=0.0.0.0, PORT=443 and HTTP_REDIRECT_PORT=80 open to the internet.
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=
LETSENCRYPT_SKIP_CHECK=
ACME_DIRECTORY_URL=
# C. Self-signed (the default without A or B): extra names for it, comma-separated.
TLS_HOSTNAMES=
# Whose X-Forwarded-* headers to believe (a load balancer in front): its address or CIDR, uniquelocal, on or off.
TRUST_PROXY=

# Time zone for scheduled work, e.g. Asia/Dubai.
TZ=UTC

# --- First run (all optional) ---------------------------------------------------------------------------------
# The first administrator's email (default admin@hawk.local). With ADMIN_PASSWORD too, that is their first
# password instead of a generated one; they choose their own at first sign-in either way.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# setup-code: print a setup code in the log instead, and create the first administrator on the sign-in page.
FIRST_ADMIN=
# <email>: the person deploying accepts the licence agreement (TERMS.md) for the organisation and everyone, on
# record; a copy is emailed to them once the email server is set up and tested.
ACCEPT_TERMS=
# The organisation's name (else the administrator gives it when accepting the terms).
ORGANISATION_NAME=

# --- Licence agreement (TERMS.md; Settings → About) ----------------------------------------------------------
# Written into the licence agreement wherever it is shown, accepted and emailed. Each is one line; leave empty for
# the default shown. Changing any of them changes the agreement's text (and its SHA-256), so every administrator is
# asked to accept it again at their next sign-in. Have them reviewed by a lawyer before use.
# The licensor's registered legal name (default: "the licensor named in your order or activation code").
LICENSOR_LEGAL_NAME=
# The licensor's registered address (default: "as stated in your order or activation code").
LICENSOR_ADDRESS=
# Where legal notices to the licensor go (default: "the notice email address stated in your order or activation code").
LICENSOR_NOTICE_EMAIL=
# The governing law (default: "the federal laws of the United Arab Emirates as applied in the Emirate of Dubai").
GOVERNING_LAW=
# The disputes forum, completing "...shall be referred to and finally resolved by" (default: DIAC arbitration under
# the DIAC Arbitration Rules, one arbitrator, seat Dubai (onshore, not the DIFC), in English).
DISPUTE_FORUM=
# The liability cap when no fees were paid in the 12 months before a claim (default: "five hundred UAE dirhams (AED 500)").
LIABILITY_CAP_NO_FEES=

# --- Backups (/settings/guide/backups; Settings → Backups & health) ------------------------------------------
# Where backups go on this machine (an absolute path; default ${HAWK_DATA_DIR}/backups). Better on another disk or a
# network share, so losing one disk does not lose both.
BACKUP_DIR=
# How many are kept, and how often one is made (the first one a minute after start; 0 turns the schedule off).
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# Encrypts every backup with this passphrase (it wins over the server's own backup key). Keep it away from this
# server: it is needed to restore.
BACKUP_PASSPHRASE=
# off: keep backups plain on purpose (BACKUP_PASSPHRASE still wins).
BACKUP_ENCRYPTION=
# The backup mailbox: every encrypted backup up to 15 MB is emailed there. A new, empty server with the same
# BACKUP_EMAIL, BACKUP_EMAIL_PASSWORD and BACKUP_PASSPHRASE (or the saved backup key) restores itself from it.
BACKUP_EMAIL=
BACKUP_EMAIL_PASSWORD=
# The mailbox's server (default SMTP_HOST), its port (993; another port must offer STARTTLS) and account (default
# BACKUP_EMAIL).
BACKUP_EMAIL_IMAP_HOST=
BACKUP_EMAIL_IMAP_PORT=993
BACKUP_EMAIL_USER=
# At most one "Hawk AI stopped" email (with a backup) to the administrators in this many hours.
LAST_WORDS_EVERY_HOURS=6

# --- Email server (for the backup mailbox and the "Hawk AI stopped" email) -----------------------------------------
# 587 with STARTTLS, or 465 with SMTP_SECURE=true. A password is never sent without encryption.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The From address (default SMTP_USER) and name.
SMTP_FROM=
SMTP_FROM_NAME=
# false: the mail server's certificate is not checked (said in the log). Leave it on.
SMTP_REJECT_UNAUTHORIZED=

# --- Sizing ----------------------------------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=4

# --- Identity of this deployment (lower-case letters, digits and dashes) -------------------------------------------
DEPLOYMENT_ID=hawk
DEPLOYMENT_REGION=on-premise
DEPLOYMENT_DATA_LOCATION=on-premise

# --- Updates and software integrity (/settings/guide/updates, /settings/guide/updates) ---------------------------------------------
# Empty: build the images from this checkout (update with git pull, then deploy/install.sh). latest, stable or a version
# (e.g. 0.2.0): run the published images, with the updater, so owners and admins update and roll back from
# Settings → Updates. latest is every merged release; stable the one the maintainer promoted.
HAWK_RELEASE=
# Where the images come from (<UPDATE_IMAGE>-api, -web, -proxy, -updater). A private copy: its name, and a read-only token.
UPDATE_IMAGE=ghcr.io/cxsmtp/hk
UPDATE_REGISTRY_TOKEN=
# How long a new version may take to be healthy before the updater puts the previous one back.
UPDATE_START_TIMEOUT_SECONDS=150
# How often auto-update looks for a new release once an owner or admin turns it on (it is off by default).
AUTO_UPDATE_EVERY_SECONDS=900
# How often Hawk AI checks its own files and their signature.
INTEGRITY_CHECK_HOURS=6
# allow: a server that cannot reach api.github.com installs with the file check alone.
INTEGRITY_OFFLINE=
# Optional: a GitHub token for api.github.com's attestations (only when its anonymous limit is reached).
INTEGRITY_GITHUB_TOKEN=
# off: no updater, even with the published images.
HAWK_UPDATER=

# --- Sign-in (/settings/guide/people-and-access) ------------------------------------------------------------------
# Minutes an unused sign-in lasts (8 hours by default).
SESSION_IDLE_MINUTES=480
# <email>: take that person's two-step sign-in off once, at the next start (then remove it again).
RESET_TWO_STEP=
# Single sign-on with OpenID Connect (Entra ID, Okta, ...). COMPANY_SSO_ENABLED=true and one provider, e.g.
#   OIDC_PROVIDERS_JSON=[{"key":"entra","kind":"entra","display_name":"Microsoft Entra ID","workspace_slug":"<workspace>","issuer":"https://login.microsoftonline.com/<directory id>/v2.0","client_id":"<application id>","tenant_id":"<Hawk AI tenant id>"}]
#   OIDC_PROVIDER_SECRETS_JSON={"entra":"<client secret>"}      (kind is entra or okta)
#   OIDC_CALLBACK_URL=https://hawk.example.com/api/auth/oidc/callback
COMPANY_SSO_ENABLED=false
OIDC_PROVIDERS_JSON=[]
OIDC_PROVIDER_SECRETS_JSON=
OIDC_BINDINGS_JSON=[]
OIDC_CALLBACK_URL=
OIDC_FRONTEND_URL=

# --- The self-check and hands-off (/settings/guide/self-check-and-help) ------------------------------------------------------------------
# How often Hawk AI checks itself, and how often it reads replies to its emails (when Settings → Hands-off says so).
WATCHDOG_EVERY_SECONDS=300
INBOX_EVERY_SECONDS=120
# How often self-recovery reads the error journal and the failed jobs and fixes what it knows (/settings/guide/troubleshooting).
SELF_RECOVERY_EVERY_SECONDS=300
# Where administrators are asked to forward the support cases Hawk AI raises by itself (it never sends outside itself).
MAINTAINER_EMAIL=

# ---- Get help (/settings/guide/self-check-and-help) ----
# SUPPORT_MODE=email sends Get help requests by email to SUPPORT_EMAIL instead of the built-in portal.
#SUPPORT_MODE=
#SUPPORT_EMAIL=

# ---- Company web proxy (/settings/guide/network) ----
# Usually set under Settings → Network & proxy, which checks it first. These are the alternative.
#HTTPS_PROXY=
#NO_PROXY=

# ---- Logs ----
# api, worker and beat write one JSON object a line (docker compose logs api); text is easier to read by eye.
#LOG_FORMAT=json
# DEBUG, INFO (the default), WARNING or ERROR.
#LOG_LEVEL=INFO
