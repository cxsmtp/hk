POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicontrol
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/aicontrol
REDIS_URL=redis://redis:6379/0
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/aicontrol
TEST_REDIS_URL=redis://redis:6379/0
API_HOST=0.0.0.0
API_PORT=8000
# Dev/test/demo bootstrap only; startup rejects this for every other ENV.
SELF_REGISTRATION_ENABLED=false
SECRET_KEY=change-me-super-secret
SECRET_KEY_LOCK_ENABLED=true
SECRET_KEY_LOCK_FILE=.runtime/secret_key.lock
SECRET_KEY_LOCK_PEPPER=replace-with-distinct-lock-pepper
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Replace with the installed browser extension ID shown at chrome://extensions.
# For multiple browsers, comma-separate every extension origin.
EXTENSION_CORS_ORIGINS=
NEXT_PUBLIC_DEMO_FALLBACK=true
NEXT_PUBLIC_DEMO_FILL_EMPTY=true
NEXT_PUBLIC_DEMO_FORCE=false
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CONNECTOR_SECRETS_KEY=replace-with-32-byte-random-value
CONNECTOR_SECRETS_KDF_SALT=replace-with-distinct-kdf-salt
ENFORCEMENT_PAYLOADS_KEY=replace-with-distinct-payload-key
ONPREM_BUNDLE_SIGNING_SECRET=replace-with-distinct-signing-secret
# Server-admin authority for custom credentialed egress origins. Keys are exact
# sources such as "checkmarx", "checkmarx-upload", "external-risk:github",
# or "monitoring:jira".
OUTBOUND_DESTINATION_ALLOWLIST={}
LLM_PROVIDER=openai
LLM_ROUTER_MODE=council
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
LLM_TIMEOUT_SECS=30
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
LLM_INTERCEPT_QPS_PER_TENANT=10
MCP_AUTHORIZE_QPS_PER_TENANT=20
# Rollout gate: require server-issued, persisted, authenticated MCP sessions.
MCP_PERSISTED_SESSIONS_REQUIRED=false
CANONICAL_AI_ACTION_DUAL_WRITE_ENABLED=false
# Required when canonical dual-write is enabled; use a distinct explicit value of at least 32 characters.
CANONICAL_ACTION_BINDING_KEY=
AUTHORIZATION_KERNEL_V2_ENABLED=false
AUTHORIZATION_KERNEL_SHADOW_COMPARE_ENABLED=false
AUTHORIZATION_KERNEL_V2_ENFORCE=false
# Server-owned exact tenant -> surfaces JSON. Callers cannot self-enroll.
AUTHORIZATION_KERNEL_V2_ENFORCE_ROLLOUT={}
DECISION_EXECUTION_RECEIPTS_ENABLED=false
SIEM_EXPORT_ENABLED=false
# Required when enabled: generate a distinct value, for example:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SIEM_PSEUDONYMIZATION_KEY=
RECEIPT_SIGNING_ACTIVE_KEY_ID=
RECEIPT_SIGNING_KEYS_JSON={}
# Control Coverage is opt-in. Writes require an explicit {"tenant-id":true} rollout.
CONTROL_COVERAGE_MATERIALIZATION_ENABLED=false
CONTROL_COVERAGE_SNAPSHOT_ENABLED=false
CONTROL_COVERAGE_API_ENABLED=false
CONTROL_COVERAGE_UI_ENABLED=false
NEXT_PUBLIC_CONTROL_COVERAGE_UI_ENABLED=false
CONTROL_COVERAGE_ROLLOUT={}
DEPLOYMENT_FAMILY_EXPERIENCE_ENABLED=false
DEPLOYMENT_FAMILY_COVERAGE_ENABLED=false
CONTROL_COVERAGE_DEFAULT_WINDOW_DAYS=30
CONTROL_COVERAGE_SNAPSHOT_INTERVAL_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=1.0
FAIL_SECURE_MODE=true
CONTROL_PLANE_STRICT_DEPENDENCY_CHECKS=true
CONTROL_PLANE_HEARTBEAT_MAX_AGE_SECONDS=120
PLATFORM_MODE_DEFAULT=enforce
