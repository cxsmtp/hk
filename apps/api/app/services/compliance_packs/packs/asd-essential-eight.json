  "requirements": [
    {
      "id": "E8-AC",
      "title": "Application control",
      "applicability": "customer",
      "controls": [
        "ai.approval_policy",
        "ai.discovery"
      ],
      "evidence": [
        "settings:approvals",
        "records:approvals",
        "audit:approvals",
        "records:ai_inventory",
        "records:attestations"
      ],
      "note": "Hawk AI applies an allow-only-approved rule to AI systems; workstation application control is the customer's."
    },
    {
      "id": "E8-PA",
      "title": "Patch applications",
      "applicability": "product",
      "controls": [
        "software.integrity"
      ],
      "evidence": [
        "audit:updates",
        "records:attestations"
      ]
    },
    {
      "id": "E8-MM",
      "title": "Configure Microsoft Office macro settings",
      "applicability": "customer",
      "controls": [],
      "evidence": [
        "records:attestations"
      ]
    },
    {
      "id": "E8-UH",
      "title": "User application hardening",
      "applicability": "customer",
      "controls": [
        "ai.gateway_in_use"
      ],
      "evidence": [
        "audit:gateway",
        "records:attestations"
      ]
    },
    {
      "id": "E8-RA",
      "title": "Restrict administrative privileges",
      "applicability": "product",
      "controls": [
        "access.roles",
