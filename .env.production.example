# Copy to .env.production outside source control and replace every /etc/hawk path.
# Secret files must be absolute, regular, non-symlink files and not group/world writable.
ENV=production
DEMO_MODE=false
PILOT_MODE=false
SELF_REGISTRATION_ENABLED=false
DEPLOYMENT_ID=hawk-bank-primary
DEPLOYMENT_REGION=uae-north
DEPLOYMENT_DATA_LOCATION=uae
DEPLOYMENT_TOPOLOGY=single_node_compose
COMPONENT_VERSION=0.1.0
COMPONENT_PROTOCOL_VERSION=1.0
MINIMUM_COMPONENT_VERSIONS_JSON={"api":"0.1.0","worker":"0.1.0","celery_beat":"0.1.0","web":"0.1.0"}

POSTGRES_USER=hawk
POSTGRES_DB=hawk
POSTGRES_PASSWORD_FILE=/etc/hawk/secrets/postgres_password
REDIS_PASSWORD_FILE=/etc/hawk/secrets/redis_password
DATABASE_URL_FILE=/etc/hawk/secrets/database_url
REDIS_URL_FILE=/etc/hawk/secrets/redis_url
CELERY_BROKER_URL_FILE=/etc/hawk/secrets/celery_broker_url
CELERY_RESULT_BACKEND_FILE=/etc/hawk/secrets/celery_result_backend
SECRET_KEY_FILE=/etc/hawk/secrets/secret_key
SECRET_KEY_LOCK_ENABLED=true
SECRET_KEY_LOCK_PEPPER_FILE=/etc/hawk/secrets/secret_key_lock_pepper
CONNECTOR_SECRETS_KEY_FILE=/etc/hawk/secrets/connector_secrets_key
CONNECTOR_SECRETS_KDF_SALT_FILE=/etc/hawk/secrets/connector_secrets_kdf_salt
ENFORCEMENT_PAYLOADS_KEY_FILE=/etc/hawk/secrets/enforcement_payloads_key
ONPREM_BUNDLE_SIGNING_SECRET_FILE=/etc/hawk/secrets/onprem_bundle_signing_secret
CANONICAL_ACTION_BINDING_KEY_FILE=/etc/hawk/secrets/canonical_action_binding_key
RECEIPT_SIGNING_KEYS_JSON_FILE=/etc/hawk/secrets/receipt_signing_keys_json

WEB_ORIGIN=https://hawk.example.com
API_BASE_URL=https://api.hawk.example.com
NEXT_PUBLIC_API_URL=https://api.hawk.example.com
CORS_ORIGINS=https://hawk.example.com
EXTENSION_CORS_ORIGINS=
TRUSTED_HOSTS=api.hawk.example.com,127.0.0.1,localhost
MAX_REQUEST_BODY_BYTES=2097152

CONTROL_PLANE_STRICT_DEPENDENCY_CHECKS=true
CONTROL_PLANE_HEARTBEAT_MAX_AGE_SECONDS=120
FAIL_SECURE_MODE=true
GOVERNANCE_STRICT_MODE=true
MCP_PERSISTED_SESSIONS_REQUIRED=true
GATEWAY_INTERCEPT_MINIMAL_MODE=false
PLATFORM_MODE_DEFAULT=enforce
CELERY_WORKER_CONCURRENCY=4

# Preserve the approved Phase 1-8 rollout flags from the controlled deployment.
# Do not enable a capability merely because it is present in source.
CONTROL_COVERAGE_API_ENABLED=true
NEXT_PUBLIC_CONTROL_COVERAGE_UI_ENABLED=true

HAWK_APP_ENV_FILE=../.env.production
HAWK_POSTGRES_VOLUME_NAME=hawk_production_postgres_data
HAWK_REDIS_VOLUME_NAME=hawk_production_redis_data
HAWK_RUNTIME_VOLUME_NAME=hawk_production_runtime_state
