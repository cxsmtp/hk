#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def main() -> int:
    repo_root = Path(__file__).resolve().parents[1]
    api_root = repo_root / "apps" / "api"
    sys.path.insert(0, str(api_root))

    parser = argparse.ArgumentParser(description="Clean expired auditor export artifacts.")
    parser.add_argument("--retention-days", type=int, default=90)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    from app.db.session import SessionLocal
    from app.services.snapshot_service import cleanup_auditor_artifacts

    db = SessionLocal()
    try:
        result = cleanup_auditor_artifacts(db, retention_days=args.retention_days, dry_run=args.dry_run)
        db.commit()
    finally:
        db.close()
    print(json.dumps(result, indent=2, default=str))
    return 0 if result.get("error_count", 0) == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
